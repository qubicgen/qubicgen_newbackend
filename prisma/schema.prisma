// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model user{
  id Int @id @default(autoincrement())
  name String?
  email String?
  password String?
}

model getInTouch{
  id String @id @default(uuid())
  fullName String?
  email String?
  message String?
}

model queries{
  id String @id @default(uuid())
  firstName String
  lastName String
  email String
  jobTitle String
  company String
  phone String
  message String
}

model careers{
  id String @id @default(uuid())
  fullName String
  gender String
  phoneNumber String
  whatsappNumber String
  personalEmail String
  officeEmail String
  course String
  branch String
  collegeName String
  address String
  passedOutYear DateTime
  tenthPercentage String
  twelthPercentage String
  graduationPercentage String
  resume String
  comments String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt  
}
model projectForm{
  id String @id @default(uuid())
  name String
  email String
  phone String
  jobTitle String
  company String
  message String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model studentForm{
  id String @id @default(uuid())
  name String
  email String
  phone String
  course String
  college String
  stream String
  message String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model course{
  id String @id @default(uuid())
  courseName String?
  courseType String?
  duration Int?
  maxMentees Int?
  technologies String?
  rating Int?
  startDate DateTime?
  endDate DateTime?
  courseDescription String?
  courseImage String?
  courseBanner String?
  brochure String?
  certificate String?
  certificate2 String?
  selfPaced Int?
  mentorship Int?
  dualPath Int?
  courseBrands brands[]
  courseLessons lessons[]
  courseFaqs faqs[]
  courseCertificates certificates[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model brands{
  id String @id @default(uuid())
  brandLogo String?
  courseId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course course? @relation(fields: [courseId],references: [id])
}

model certificates{
  id String @id @default(uuid())
  certificateUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courseId String?
  course course? @relation(fields: [courseId],references: [id])
}
model lessons{
  id String @id @default(uuid())
  lessonTitle String?
  lessonDescription String?
  courseId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course course? @relation(fields: [courseId],references: [id])
}

model faqs{
  id String @id @default(uuid())
  question String?
  answer String?
  courseId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course course? @relation(fields: [courseId],references: [id])
}

model courseEnrollmentForm{
  id String @id @default(uuid())
  fullName String?
  contactNumber String?
  email String?
  coursePrice Int?
  programName String?
  collegeName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model testimonials{
  id String @id @default(uuid())
  name String?
  email String?
  designation String?
  testimonial String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}